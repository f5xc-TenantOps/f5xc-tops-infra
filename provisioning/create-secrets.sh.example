#!/usr/bin/env bash
# create-secrets.sh.example — template for tenant token secrets (committed, tokenless)
#
# For each new child tenant, Crossplane's SSM Parameters (crossplane/aws/shared/ssm.yaml)
# reference two K8s secrets via valueSecretRef:
#
#   tops-<tenant>-token-name-v2   -> XC service-credential NAME  (String param)
#   tops-<tenant>-token-value-v2  -> XC service-credential TOKEN (SecureString param)
#
# Both live in namespace crossplane-system under key "value".
#
# Copy this to create-secrets.sh (gitignored), fill in real values, and run it.
#   cp provisioning/create-secrets.sh.example provisioning/create-secrets.sh
set -euo pipefail

NS=crossplane-system

mk() {  # mk <secret-name> <value>
  kubectl -n "$NS" create secret generic "$1" \
    --from-literal=value="$2" \
    --dry-run=client -o yaml | kubectl apply -f -
}

# --- <tenant-slug> ---
mk tops-<tenant-slug>-token-name-v2   'REPLACE_WITH_SVC_CRED_NAME'
mk tops-<tenant-slug>-token-value-v2  'REPLACE_WITH_SVC_CRED_TOKEN'

echo "Verify: kubectl -n $NS get secret | grep <tenant-slug>"
